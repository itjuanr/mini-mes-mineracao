@page "/"
@inject EquipamentoService Servico

<PageTitle>Painel da Frota · Mini MES</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Painel da Frota</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Estado atual dos equipamentos — na Fase 2 o simulador vai movimentar a frota sozinho.
</MudText>

@if (_frota is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

<MudGrid Class="mb-4">
    @foreach (var estado in Enum.GetValues<EstadoEquipamento>())
    {
        <MudItem xs="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@estado.Descricao()</MudText>
                <MudText Typo="Typo.h4" Color="@CorDoEstado(estado)">@_frota.Count(e => e.Estado == estado)</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudGrid>
    @foreach (var equipamento in _frota)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.h6">@equipamento.Tag</MudText>
                        <MudIcon Icon="@IconeDoTipo(equipamento.Modelo.Tipo)" Color="Color.Primary" />
                    </div>
                    <MudText Typo="Typo.body2">@equipamento.Modelo.Nome</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">@equipamento.Area.Nome</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@CorDoEstado(equipamento.Estado)">
                        @equipamento.Estado.Descricao()
                    </MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private List<Equipamento>? _frota;

    protected override async Task OnInitializedAsync()
    {
        _frota = await Servico.ListarAsync();
    }
}
