@page "/estrutura"
@inject EquipamentoService Servico

<PageTitle>Estrutura · Mini MES</PageTitle>

<div class="mes-page-header">
    <div>
        <h1>Estrutura de Ativos</h1>
        <p class="mes-muted">Hierarquia Site → Área → Equipamento (modelo ISA-95)</p>
    </div>
</div>

@if (_sites is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

@foreach (var site in _sites)
{
    var equipamentosDoSite = site.Areas.SelectMany(a => a.Equipamentos).ToList();

    <div class="mes-painel mb-6">
        <div class="mes-painel-topo">
            <div class="d-flex align-center gap-3">
                <div class="mes-logo"><MudIcon Icon="@Icons.Material.Rounded.Landscape" Size="Size.Small" /></div>
                <div>
                    <div class="mes-painel-titulo">@site.Nome</div>
                    <div class="mes-muted mes-pequeno">
                        <span class="mes-mono">@site.Codigo</span> · @site.Areas.Count áreas · @equipamentosDoSite.Count equipamentos
                    </div>
                </div>
            </div>
        </div>

        <div class="mes-areas mt-4">
            @foreach (var area in site.Areas.OrderBy(a => a.Nome))
            {
                <div class="mes-area">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <div class="mes-painel-titulo">@area.Nome</div>
                            <div class="mes-muted mes-pequeno mes-mono">@site.Codigo / @area.Codigo</div>
                        </div>
                        <span class="mes-contador">@area.Equipamentos.Count</span>
                    </div>

                    <DistribuicaoEstados Equipamentos="area.Equipamentos" />

                    @foreach (var equipamento in area.Equipamentos.OrderBy(e => e.Tag))
                    {
                        <div class="mes-area-item">
                            <MudIcon Icon="@IconeDoTipo(equipamento.Modelo.Tipo)" Size="Size.Small" Class="mes-muted" />
                            <div class="mes-celula-dupla flex-grow-1">
                                <span class="mes-mono"><b>@equipamento.Tag</b></span>
                                <span class="mes-muted mes-pequeno">@equipamento.Modelo.Nome</span>
                            </div>
                            <EstadoBadge Estado="equipamento.Estado" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Site>? _sites;

    protected override async Task OnInitializedAsync()
    {
        _sites = await Servico.ListarEstruturaAsync();
    }
}
