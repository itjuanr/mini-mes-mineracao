@page "/equipamentos"
@inject EquipamentoService Servico
@inject IDialogService Dialogos
@inject ISnackbar Avisos

<PageTitle>Equipamentos · Mini MES</PageTitle>

<div class="mes-page-header">
    <div>
        <h1>Equipamentos</h1>
        <p class="mes-muted">Cadastro da frota: tag, modelo, área e estado</p>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add"
               OnClick="() => AbrirFormulario(null)" DropShadow="false">
        Novo equipamento
    </MudButton>
</div>

<MudTable Items="_equipamentos" Loading="_equipamentos is null" Filter="new Func<Equipamento, bool>(Filtrar)"
          Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Sm" Class="mes-tabela">
    <ToolBarContent>
        <MudTextField @bind-Value="_busca" Placeholder="Buscar por tag, modelo ou área" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Rounded.Search" Immediate="true" Clearable="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:360px" />
        <MudSpacer />
        @if (_equipamentos is not null)
        {
            <span class="mes-muted mes-pequeno">@_equipamentos.Count(Filtrar) de @_equipamentos.Count equipamentos</span>
        }
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Tag</MudTh>
        <MudTh>Modelo</MudTh>
        <MudTh>Tipo</MudTh>
        <MudTh>Localização</MudTh>
        <MudTh>Estado</MudTh>
        <MudTh Style="text-align:right">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Tag"><span class="mes-mono"><b>@context.Tag</b></span></MudTd>
        <MudTd DataLabel="Modelo">
            <div class="mes-celula-dupla">
                <span>@context.Modelo.Nome</span>
                <span class="mes-muted mes-pequeno">@context.Modelo.Fabricante</span>
            </div>
        </MudTd>
        <MudTd DataLabel="Tipo">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@IconeDoTipo(context.Modelo.Tipo)" Size="Size.Small" Class="mes-muted" />
                @context.Modelo.Tipo.Descricao()
            </div>
        </MudTd>
        <MudTd DataLabel="Localização">
            <div class="mes-celula-dupla">
                <span>@context.Area.Nome</span>
                <span class="mes-muted mes-pequeno">@context.Area.Site.Nome</span>
            </div>
        </MudTd>
        <MudTd DataLabel="Estado"><EstadoBadge Estado="context.Estado" /></MudTd>
        <MudTd DataLabel="Ações" Style="text-align:right; white-space:nowrap">
            <MudTooltip Text="Editar">
                <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" OnClick="() => AbrirFormulario(context)" />
            </MudTooltip>
            <MudTooltip Text="Excluir">
                <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error"
                               OnClick="() => Excluir(context)" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <div class="pa-8 mes-muted">Nenhum equipamento encontrado.</div>
    </NoRecordsContent>
</MudTable>

@code {
    private List<Equipamento>? _equipamentos;
    private string _busca = string.Empty;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar() => _equipamentos = await Servico.ListarAsync();

    private bool Filtrar(Equipamento e) =>
        string.IsNullOrWhiteSpace(_busca)
        || e.Tag.Contains(_busca, StringComparison.OrdinalIgnoreCase)
        || e.Modelo.Nome.Contains(_busca, StringComparison.OrdinalIgnoreCase)
        || e.Area.Nome.Contains(_busca, StringComparison.OrdinalIgnoreCase);

    private async Task AbrirFormulario(Equipamento? equipamento)
    {
        var parametros = new DialogParameters<EquipamentoDialog> { { d => d.Equipamento, equipamento } };
        var titulo = equipamento is null ? "Novo equipamento" : $"Editar {equipamento.Tag}";
        var dialogo = await Dialogos.ShowAsync<EquipamentoDialog>(titulo, parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false })
        {
            Avisos.Add("Equipamento salvo.", Severity.Success);
            await Carregar();
        }
    }

    private async Task Excluir(Equipamento equipamento)
    {
        var confirmou = await Dialogos.ShowMessageBox("Excluir equipamento",
            $"Tem certeza que deseja excluir {equipamento.Tag}?", yesText: "Excluir", cancelText: "Cancelar");
        if (confirmou != true)
            return;

        try
        {
            await Servico.ExcluirAsync(equipamento.Id);
            Avisos.Add($"{equipamento.Tag} excluído.", Severity.Info);
            await Carregar();
        }
        catch (RegraDeNegocioException ex)
        {
            Avisos.Add(ex.Message, Severity.Error);
        }
    }
}
