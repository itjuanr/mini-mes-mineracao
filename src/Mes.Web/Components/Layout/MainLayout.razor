@inherits LayoutComponentBase

<MudThemeProvider Theme="_tema" @bind-IsDarkMode="_modoEscuro" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _menuAberto = !_menuAberto" />
        <MudIcon Icon="@Icons.Material.Filled.Factory" Class="mx-2" />
        <MudText Typo="Typo.h6">Mini MES · Mineração</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_modoEscuro ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="() => _modoEscuro = !_modoEscuro" />
    </MudAppBar>

    <MudDrawer @bind-Open="_menuAberto" ClipMode="DrawerClipMode.Always" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Painel da Frota</MudNavLink>
            <MudNavLink Href="estrutura" Icon="@Icons.Material.Filled.AccountTree">Estrutura</MudNavLink>
            <MudNavLink Href="equipamentos" Icon="@Icons.Material.Filled.Construction">Equipamentos</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.PauseCircle">Paradas</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.Scale">Produção</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.LocalGasStation">Consumo</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.Insights">Indicadores</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Ocorreu um erro inesperado.
    <a href="" class="reload">Recarregar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _menuAberto = true;
    private bool _modoEscuro = true;

    private readonly MudTheme _tema = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#E87722",
            AppbarBackground = "#1F2A33",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#F59E0B",
            Background = "#12171C",
            Surface = "#1B232B",
            DrawerBackground = "#161D23",
            AppbarBackground = "#161D23",
        },
        Typography = new Typography
        {
            Default = new Default { FontFamily = ["Inter", "Roboto", "sans-serif"] }
        }
    };
}
